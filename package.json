    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@playwright/test": "^1.60.0",
    "puppeteer": "^24.43.1"
  }
}
