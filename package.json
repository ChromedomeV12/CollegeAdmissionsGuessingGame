{
  "name": "admissions-oracle-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "node e2e_test.cjs",
