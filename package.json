{
  "name": "admissions-oracle-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:production",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "node e2e_test.cjs",
    "test:production": "npm run build && E2E_PRODUCTION=1 node e2e_test.cjs && node production_smoke.cjs",
    "approve": "node scripts/scrape.js --approve",
    "export-verified": "node scripts/export-verified.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@playwright/test": "^1.60.0",
    "@tabler/icons-webfont": "3.19.0",
    "esbuild": "0.28.2",
    "puppeteer": "25.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0"
  }
}
