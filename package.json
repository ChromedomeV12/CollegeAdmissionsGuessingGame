{
  "name": "admissions-oracle-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "vinext start",
    "start:legacy": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "build": "npm run build:cloudflare",
    "build:legacy": "node scripts/build.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:production",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "node e2e_test.cjs",
    "test:production": "npm run build:legacy && E2E_PRODUCTION=1 node e2e_test.cjs && node production_smoke.cjs",
    "test:cloudflare": "npm run build:cloudflare",
    "db:generate": "drizzle-kit generate",
    "approve": "node scripts/scrape.js --approve",
    "export-verified": "node scripts/export-verified.js",
    "dev": "vinext dev",
    "dev:legacy": "node --watch server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "0.45.2",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "next": "16.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tabler/icons-webfont": "3.19.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "puppeteer": "25.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "three": "0.160.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0",
      "sharp": "^0.35.3",
      "ws": "8.21.3"
    },
    "esbuild@<0.28.1": ">=0.28.1",
    "ws": "8.21.3",
    "esbuild": "$esbuild",
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
