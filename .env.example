# Port the Express backend (server.js) listens on. Consumed by server.js.
PORT=3005

# Secret used to sign JWT auth tokens. Consumed by server.js.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Maintainer-only Reddit submission tooling. Disabled unless explicitly enabled.
SUBMISSIONS_ENABLED=false
# Nonempty secret required as X-Maintainer-Key on enabled submission routes.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAINTAINER_API_KEY=


# Reddit "web app" OAuth credentials used only for one-time ownership proof
# (the preferred path). Register the exact redirect URI in Reddit's app
# settings. Without all three, the app falls back to an edit-code flow:
# the submitter pastes an ORACLE-XXXXXX receipt code into their Reddit post
# to prove ownership, then a human reviewer confirms the post contains it.
# See docs/CONSENT_IMPORT.md.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3005/api/submissions/reddit/callback

# Reddit requires a descriptive User-Agent. Replace the maintainer handle when
# deploying a fork, while keeping the app name and version identifiable.
REDDIT_USER_AGENT=web:AdmissionsOracle:1.0 (by /u/MJanW)

# Optional. When set, `npm run approve` asks an LLM (OpenRouter) to structure
# consented Reddit drafts into full GameRecords. Without it, approved drafts
# are written as defensive scaffolds with empty fields that render as empty
# states — still playable, just sparse.
OPENROUTER_API_KEY=
