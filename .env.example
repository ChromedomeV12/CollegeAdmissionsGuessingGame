# Port the Express backend (server.js) listens on. Consumed by server.js.
PORT=3005

# Secret used to sign JWT auth tokens. Consumed by server.js.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Reddit "web app" OAuth credentials used only for one-time ownership proof.
# Register the exact redirect URI in Reddit's app settings.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3005/api/submissions/reddit/callback

# Reddit requires a descriptive User-Agent. Replace the maintainer handle when
# deploying a fork, while keeping the app name and version identifiable.
REDDIT_USER_AGENT=web:AdmissionsOracle:1.0 (by /u/MJanW)
